# AlgoVault Production Environment Variables Template
# Copy this file to .env or set these in your production deployment environment.
# NEVER commit real secret keys to public git repositories.

# Application Configuration
VITE_APP_NAME="AlgoVault"
VITE_APP_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:4000/api/v1"

# Payment Gateway (Razorpay - India & Global Launch)
# Public Key (Safe for client-side checkout initiation)
VITE_RAZORPAY_KEY_ID="rzp_test_549382109842"
# Secret Key (Strictly Server-Side for signature verification & webhooks)
RAZORPAY_KEY_SECRET="rzp_secret_mock_839201948291038"
PAYMENT_WEBHOOK_SECRET="whsec_algo_8f7b2c91a03e4d5f6b7c8d9e0"

# JWT & License Cryptographic Signing (Strictly Server-Side)
JWT_SECRET="super-secret-jwt-token-signing-key-minimum-32-chars-long"
# Ed25519 Private Key for signing offline desktop licenses (PEM or Base64)
LICENSE_ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgMockPrivateKeyAlgoVaultProductionKeySecret1234567890=\n-----END PRIVATE KEY-----"
# Public verification key embedded in Desktop binary for offline signature verification
VITE_LICENSE_PUBLIC_KEY="MCowBQYDK2VwAyEAMockPublicKeyAlgoVaultDesktopVerifier1234567890="

# Database (PostgreSQL)
DATABASE_URL="postgresql://algovault_user:production_password@localhost:5432/algovault_prod?sslmode=require"

# CDN / S3 Object Storage for Desktop Installers
S3_BUCKET_NAME="algovault-releases"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
CDN_DOWNLOAD_BASE_URL="https://releases.algovault.dev"

# Email Delivery (Transactional Auth & Receipts)
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT="587"
SMTP_USER="algovault-mailer"
SMTP_PASS="postmark_api_token"
EMAIL_FROM="AlgoVault Team <support@algovault.dev>"
